{
  "name": "securesign",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "concurrently -n \"CORE,WEB\" -c \"green,cyan\" \"pnpm dev:core\" \"pnpm dev:web\"",
    "dev:core": "uv run --directory core uvicorn app.main:app --reload --port 8000",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "lint:web": "pnpm --filter web lint",
    "lint:core": "uv run --directory core ruff check .",
    "test:core": "uv run --directory core pytest"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
